---
import Features from "../components/home/Features.astro";
import FinalCta from "../components/home/FinalCta.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import NameStory from "../components/home/NameStory.astro";
import Story from "../components/home/Story.astro";
import Vision from "../components/home/Vision.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={site.name} description={site.pitch} bodyClass="home">
  <Story />
  <Features />
  <HowItWorks />
  <NameStory />
  <Vision />
  <FinalCta />
</BaseLayout>

<script>
  import { initReveal } from "../scripts/reveal";
  initReveal();
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .reveal-ready [data-reveal]:not(.is-revealed) {
      opacity: 0;
      transform: translateY(24px);
    }
    .reveal-ready [data-reveal].is-revealed:not(.is-instant) {
      transition:
        opacity 0.8s var(--ease-out),
        transform 0.8s var(--ease-out);
    }
  }
</style>
