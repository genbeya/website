---
/** The bottom of the docs' mobile menu: the site's sections and the theme toggle. */
import NavLinks from "../NavLinks.astro";
import ThemeToggle from "../ThemeToggle.astro";
---

<div class="mobile-menu-footer">
  <NavLinks layout="menu" label="Site" />
  <div class="mobile-menu-footer__theme">
    <span>Theme</span>
    <ThemeToggle />
  </div>
</div>

<style>
  .mobile-menu-footer {
    display: grid;
    gap: 0.75rem;
    padding-block: 1rem calc(1rem + var(--notice-room, 0px));
    border-top: 1px solid var(--sl-color-hairline);
  }
  .mobile-menu-footer__theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.75rem;
    color: var(--text-2);
    font-size: var(--sl-text-sm);
  }
</style>
