---
import { Image } from "astro:assets";
import conflict from "../../assets/screens/conflict.png";
import taskBoard from "../../assets/screens/task-board.png";
import wikiReferences from "../../assets/screens/wiki-references.png";
import Icon, { type IconName } from "./Icon.astro";

const small: { icon: IconName; title: string; body: string }[] = [
  {
    icon: "code",
    title: "A real editor",
    body: "CodeMirror with find and replace, several cursors, folding, coloured bracket pairs and a minimap.",
  },
  {
    icon: "search",
    title: "Search everything",
    body: "Pages, tasks and code in one search (Ctrl+Shift+F), powered by git grep.",
  },
  {
    icon: "remote",
    title: "Runs where the repo is",
    body: "Repositories on this computer, in WSL or over SSH, with a remote folder browser. Git runs on that machine.",
  },
  {
    icon: "terminal",
    title: "A terminal in the room",
    body: "A shell in the repository (Ctrl+`), on the machine it lives on.",
  },
  {
    icon: "share",
    title: "Links that open things",
    body: "Copy a link that opens a page, task, file or commit in a coworker's Genbeya, or on your Git host.",
  },
  {
    icon: "layers",
    title: "A content branch, if you like",
    body: "Keep the wiki, the tasks or the settings on a shared branch, so they look the same on every code branch.",
  },
];
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Inside the room</p>
      <h2 id="features-title">Everything a project needs, in one window</h2>
      <p>
        A wiki, a task board, a code editor, Git tools and a terminal — working on the same plain files your team and
        your tools already use.
      </p>
    </header>

    <div class="bento">
      <article class="card card--wide card--shot" data-reveal>
        <div class="card__text">
          <span class="card__icon">
            <Icon name="wiki" />
          </span>
          <h3>Wiki &amp; references</h3>
          <p>
            Nested pages with a live preview, diagrams, math and callouts. <code class="chip-code">[[GENBEYA-12]]</code>
            ,<code class="chip-code">[[Page title]]</code> or <code class="chip-code">[[src/app.ts#L10-L20]]</code> link
            tasks, pages and lines of code, and show their live title and status.
          </p>
        </div>
        <figure class="shot">
          <Image
            src={wikiReferences}
            alt="Genbeya's wiki: a page with references to pages, a task with its status, and files"
            widths={[500, 1000]}
            sizes="(min-width: 64rem) 34rem, 92vw"
            loading="lazy"
          />
        </figure>
      </article>

      <article class="card card--wide card--shot" data-reveal>
        <div class="card__text">
          <span class="card__icon">
            <Icon name="tasks" />
          </span>
          <h3>Tasks &amp; board</h3>
          <p>
            A board or a list with readable IDs, drag and drop, task types, custom fields, templates, epics as
            swimlanes, comments — and activity read from Git history.
          </p>
        </div>
        <figure class="shot">
          <Image
            src={taskBoard}
            alt="Genbeya's task board with columns, an epic as a swimlane and task cards"
            widths={[500, 1000]}
            sizes="(min-width: 64rem) 34rem, 92vw"
            loading="lazy"
          />
        </figure>
      </article>

      <article class="card card--git card--shot" data-reveal>
        <div class="card__text">
          <span class="card__icon">
            <Icon name="git" />
          </span>
          <h3>A Git client that respects your history</h3>
          <p>
            Stage single lines, commit and amend. Branches, tags and stashes; merge, rebase (interactively too),
            cherry-pick and revert — with conflict resolution in the app and a commit graph of every branch.
          </p>
          <ul class="tags" aria-label="Git features">
            <li>Stage lines</li>
            <li>Interactive rebase</li>
            <li>Conflicts</li>
            <li>Commit graph</li>
          </ul>
        </div>
        <figure class="shot">
          <Image
            src={conflict}
            alt="Resolving a merge conflict in Genbeya, choosing between the two sides"
            widths={[500, 1000]}
            sizes="(min-width: 64rem) 40rem, 92vw"
            loading="lazy"
          />
        </figure>
      </article>

      <article class="card card--agents" data-reveal>
        <span class="card__icon">
          <Icon name="agents" />
        </span>
        <h3>Made for AI agents, too</h3>
        <p>
          A skill and an <code class="chip-code">AGENTS.md</code> section teach coding agents to track their work as
          tasks and keep project knowledge in the wiki. They read the same files you do.
        </p>
        <ul class="tags" aria-label="Agents">
          <li>Claude Code</li>
          <li>Codex</li>
          <li>Copilot</li>
          <li>Cursor</li>
        </ul>
      </article>

      {small.map((item) => (
        <article class="card card--small" data-reveal>
          <span class="card__icon">
            <Icon name={item.icon} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 40%), var(--surface);
    transition:
      border-color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .card:hover {
    border-color: var(--line-strong);
  }
  .card h3 {
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
  }
  .card p {
    margin: 0;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .card__icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.25rem;
    border: 1px solid var(--accent-line);
    border-radius: 0.6rem;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .card__text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card--wide {
    grid-column: span 3;
  }
  .card--git {
    grid-column: span 4;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
  }
  .card--git .card__text {
    flex: 0 1 38%;
  }
  .card--git .shot {
    flex: 1 1 62%;
    margin: 0 calc(-1 * clamp(1.25rem, 2.4vw, 1.75rem)) 0 0;
  }
  .card--agents {
    grid-column: span 2;
    background: radial-gradient(28rem 16rem at 100% 0%, rgb(124 127 242 / 0.16), transparent 70%), var(--surface);
  }
  .card--small {
    grid-column: span 2;
  }

  .shot {
    margin: 0.75rem calc(-1 * clamp(1.25rem, 2.4vw, 1.75rem)) calc(-1 * clamp(1.25rem, 2.4vw, 1.75rem));
    padding: 0 0 0 clamp(1.25rem, 2.4vw, 1.75rem);
  }
  .card--wide .shot {
    margin-top: auto;
    padding-top: 1rem;
  }
  .shot :global(img) {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-right: 0;
    border-bottom: 0;
    border-radius: 0.75rem 0 0 0;
    box-shadow: var(--shadow-pop);
  }
  .card--git .shot :global(img) {
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0.75rem 0 0 0.75rem;
  }
  :global(:root[data-theme="dark"]) .shot :global(img) {
    filter: brightness(0.9) contrast(1.02);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.75rem;
    font-weight: 550;
  }

  @media (max-width: 63.99rem) {
    .card--wide,
    .card--git,
    .card--agents {
      grid-column: span 6;
    }
    .card--small {
      grid-column: span 3;
    }
    .card--git {
      flex-direction: column;
      align-items: stretch;
    }
    .card--git .shot {
      margin: 0.5rem calc(-1 * clamp(1.25rem, 2.4vw, 1.75rem)) calc(-1 * clamp(1.25rem, 2.4vw, 1.75rem));
    }
    .card--git .shot :global(img) {
      border-bottom: 0;
      border-radius: 0.75rem 0 0 0;
    }
  }
  @media (max-width: 39.99rem) {
    .card--small {
      grid-column: span 6;
    }
  }
</style>
