    "M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7zM19 16c.2 1.6.9 2.3 2.5 2.5-1.6.2-2.3.9-2.5 2.5-.2-1.6-.9-2.3-2.5-2.5 1.6-.2 2.3-.9 2.5-2.5z",
  remote: "M3.5 5h17v6h-17zM3.5 13h17v6h-17zM7 8h.01M7 16h.01M11 8h6M11 16h6",
  terminal: "M4 4.5h16v15H4zM7.5 9.5l3 2.5-3 2.5M12.5 15h4",
  share: "M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7L11.5 6.8M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.5-1.5",
  layers: "M12 3 3 8l9 5 9-5zM3 12.5l9 5 9-5M3 16.5l9 5 9-5",
  diagram: "M4 4h6v5H4zM14 15h6v5h-6zM7 9v4.5a1.5 1.5 0 0 0 1.5 1.5H14",
  offline: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8.5 12.5l2.5 2.5 4.5-5",
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  <path d={paths[name]}></path>
</svg>

<style>
  .icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
