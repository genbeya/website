  git: "M6 7.5v9M18 9.5c0 4.5-12 2.5-12 7M6 2.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM6 16.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM18 4.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z",
