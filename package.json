{
  "name": "genbeya-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The website of Genbeya, genbeya.fyi",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "github-slugger": "^2.0.0",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-to-hast": "^13.2.1",
    "mermaid": "^11.17.2",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "dev": "node scripts/prepare.ts && astro dev",
    "build": "node scripts/prepare.ts && astro build && node scripts/postbuild.ts",
    "preview": "node scripts/serve.ts",
    "sync": "npm run sync-docs && npm run sync-demo",
    "sync-docs": "node scripts/sync-docs.ts",
    "sync-demo": "node scripts/sync-demo.ts",
    "fetch-release": "node scripts/fetch-release.ts",
    "check": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.ts",
    "brand-images": "node scripts/brand-images.ts"
  },
  "overrides": {
    "katex": "$katex",
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
